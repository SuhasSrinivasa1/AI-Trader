+    private suspend fun waveStats(): List<WaveStatDto> {
+        val trades = shadowDao.allTrades().filter { it.regime.startsWith("WAVE_") }
+        if (trades.isEmpty()) return (1..20).map { WaveStatDto(wave = it) }
+        val latestDates = trades.map { Instant.ofEpochMilli(it.closedAtMs).atZone(INDIA).toLocalDate() }
+            .distinct().sortedDescending().take(30).toSet()
+        val rolling = trades.filter { Instant.ofEpochMilli(it.closedAtMs).atZone(INDIA).toLocalDate() in latestDates }
+        return (1..20).map { wave ->
+            val rows = rolling.filter { waveNumber(it.regime) == wave }
+            val ups = rows.filter { it.side == "LONG" }.map { (it.exitPrice - it.entryPrice) / it.entryPrice * 100.0 }
+            val downs = rows.filter { it.side == "SHORT" }.map { (it.entryPrice - it.exitPrice) / it.entryPrice * 100.0 }
+            WaveStatDto(
+                wave = wave,
+                averageUpPct = if (ups.isEmpty()) 0.0 else ups.average(),
+                averageDownPct = if (downs.isEmpty()) 0.0 else downs.average(),
+                upSamples = ups.size, downSamples = downs.size
+            )
+        }
+    }
+
