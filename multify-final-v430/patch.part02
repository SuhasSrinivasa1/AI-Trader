+    private suspend fun finalizeForecastOutcomes(token: String, date: String) {
+        val rows = learningDao.forecastsForDate(date).filter { it.result == "PENDING" && it.entryPrice != null && it.targetPrice != null && it.stopPrice != null }
+        for (f in rows) {
+            val entry = f.entryPrice ?: continue
+            val target = f.targetPrice ?: continue
+            val stop = f.stopPrice ?: continue
+            val generated = Instant.ofEpochMilli(f.generatedAtMs).atZone(INDIA)
+            val end = runCatching { LocalDate.parse(f.forecastDate).atTime(15, 30) }.getOrNull() ?: continue
+            val payload = runCatching {
+                apiFactory.groww.historicalCandles(
+                    authorization = bearer(token), growwSymbol = "NSE-${f.symbol}",
+                    startTime = generated.toLocalDateTime().format(HIST_FORMAT), endTime = end.format(HIST_FORMAT), candleInterval = "5minute"
+                ).requirePayload("Forecast outcome ${f.symbol}")
+            }.getOrNull() ?: continue
+            var result = "FAIL"
+            var exit = payload.candles.lastOrNull()?.getOrNull(4)?.asDouble ?: entry
+            var maxFav = 0.0
+            var maxAdv = 0.0
+            for (c in payload.candles) {
+                if (c.size < 5) continue
+                val high = runCatching { c[2].asDouble }.getOrNull() ?: continue
+                val low = runCatching { c[3].asDouble }.getOrNull() ?: continue
+                if (f.bias == "LONG") {
+                    maxFav = max(maxFav, (high - entry) / entry * 100.0)
+                    maxAdv = min(maxAdv, (low - entry) / entry * 100.0)
+                    val stopHit = low <= stop
+                    val targetHit = high >= target
+                    if (stopHit) { result = "FAIL"; exit = stop; break }
+                    if (targetHit) { result = "WIN"; exit = target; break }
+                } else {
+                    maxFav = max(maxFav, (entry - low) / entry * 100.0)
+                    maxAdv = min(maxAdv, (entry - high) / entry * 100.0)
+                    val stopHit = high >= stop
+                    val targetHit = low <= target
+                    if (stopHit) { result = "FAIL"; exit = stop; break }
+                    if (targetHit) { result = "WIN"; exit = target; break }
+                }
+            }
+            val outcome = if (f.bias == "LONG") (exit - entry) / entry * 100.0 else (entry - exit) / entry * 100.0
+            learningDao.updateForecast(f.copy(result = result, outcomePct = outcome, maxFavourablePct = maxFav, maxAdversePct = maxAdv))
+        }
+    }
+
 
