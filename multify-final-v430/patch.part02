+    private fun ForecastEntity.toDto() = ForecastDto(
+        rank = rank, symbol = symbol, bias = bias, confidence = confidence, score = score, reason = reason,
+        generatedAtMs = generatedAtMs, entryPrice = entryPrice, targetPrice = targetPrice, stopPrice = stopPrice,
+        result = result, outcomePct = outcomePct, maxFavourablePct = maxFavourablePct, maxAdversePct = maxAdversePct,
