replace_once('app/src/main/java/com/suhas/ucsentinel/ui/InformationArchitectureScreens.kt','            }\n            ForecastLane.PRESSURE->{\n                item{SectionHeading("Pressure forecast","Early price-pressure research with execution readiness shown explicitly")}\n                item{FiveColumnHeader("Symbol","State","Score","Price","Target")}\n                if(pressure.isEmpty())item{EmptyState("Waiting for Pressure research","The lane remains visible even when the current scan has no usable setup.")}\n                else items(pressure.take(20),key={"pressure-${it.symbol}"}){c->\n                    val ready="EXECUTION_READY" in c.activeStrategies\n                    FiveColumnRow(c.symbol,if(ready)"Ready" else "Watch","${c.score.toInt()}","₹${"%.2f".format(c.price)}","+${"%.1f".format(c.targetMovePct?:0.0)}%",ready)\n                }\n','            }\n            ForecastLane.THREE_PM->{\n                item{SectionHeading("3 PM Next-Day Upper Circuit","Frozen near-close picks for the next trading session; created at 15:00 and revalidated through 15:30")}\n                item{FiveColumnHeader("Symbol","State","Score","Entry","Target")}\n                if(threePm.isEmpty())item{EmptyState("No frozen 3 PM list yet","The engine precomputes before 15:00, freezes the strongest next-day UC names at 15:00, then revalidates them through 15:30.")}\n                else items(threePm.take(5),key={"3pm-${it.id}"}){r->\n                    FiveColumnRow(r.symbol,"Frozen","${r.score.toInt()}","₹${"%.2f".format(r.entryPrice)}","₹${"%.2f".format(r.targetPrice)}",true)\n                }\n')
