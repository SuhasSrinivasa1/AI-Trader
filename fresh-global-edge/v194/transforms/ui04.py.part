
replace_once('app/src/main/java/com/suhas/ucsentinel/ui/MoreScreen.kt','\n@Composable\n','\n\n@Composable\nprivate fun StrategyResearchSummary(state:UiState){\n    var direction by remember{mutableStateOf(TradeDirection.LONG)}\n    val summary=state.strategyTournamentSummary\n    val setups=summary?.topSetups.orEmpty().filter{it.direction==direction}\n    val perfById=summary?.performances.orEmpty().associateBy{it.strategyId}\n    val candleKinds=setOf("ENGULFING","HAMMER","INSIDE_BAR","MORNING_STAR","THREE_SOLDIERS")\n    val defs=summary?.activeStrategies.orEmpty()\n    val directionIds=setups.flatMap{it.componentStrategyIds.ifEmpty{listOf(it.strategyId)}}.toSet()\n    val patterns=defs.filter{it.family.contains("candle",true)||it.kind in candleKinds}\n        .sortedByDescending{d->(perfById[d.id]?.accuracyPct?:0.0)+(if(d.id in directionIds)20.0 else 0.0)}.take(5)\n    val strategies=setups.distinctBy{it.strategyId}.sortedByDescending{s0->\n        val p0=perfById[s0.strategyId];(p0?.netExpectancyR?:0.0)*20+(p0?.accuracyPct?:0.0)+s0.score*0.2\n    }.take(5)\n    val combos=setups.filter{it.componentStrategyIds.distinct().size>=2}.distinctBy{it.componentStrategyIds.sorted().joinToString("+")}.sortedByDescending{it.score}.take(5)\n    val fundamentals=listOf("Revenue growth","EPS / profit growth","ROE","ROCE","Operating-margin trend","Debt / equity","Cash-flow quality","Valuation vs sector","Promoter / institutional ownership change","Earnings / result momentum")\n    ElevatedCard(Modifier.fillMaxWidth()){\n        Column(Modifier.padding(14.dp),verticalArrangement=Arrangement.spacedBy(9.dp)){\n            Text("Strategy Lab • LONG / SHORT",style=MaterialTheme.typography.titleMedium,fontWeight=FontWeight.Bold)\n            Text("Weekly catalogue refresh + off-hours shadow learning. Rankings use stored outcomes when available; missing evidence is shown as Learning rather than guessed.",style=MaterialTheme.typography.bodySmall,color=MaterialTheme.colorScheme.onSurfaceVariant)\n            Row(horizontalArrangement=Arrangement.spacedBy(8.dp)){\n                FilterChip(selected=direction==TradeDirection.LONG,onClick={direction=TradeDirection.LONG},label={Text("LONG")})\n                FilterChip(selected=direction==TradeDirection.SHORT,onClick={direction=TradeDirection.SHORT},label={Text("SHORT")})\n            }\n            Text("Top 5 candle patterns",fontWeight=FontWeight.SemiBold)\n            if(patterns.isEmpty())Text("Learning • no directional candle ranking yet",style=MaterialTheme.typography.bodySmall,color=MaterialTheme.colorScheme.onSurfaceVariant)\n            else patterns.forEachIndexed{i,d->\n                val perf=perfById[d.id]\n                Text("${i+1}. ${d.name} • ${if(perf==null||perf.observations==0)"Learning" else "${"%.0f".format(perf.accuracyPct)}% / n=${perf.observations}"}",style=MaterialTheme.typography.bodySmall)\n            }\n            HorizontalDivider()\n            Text("Top 10 company fundamentals tracked",fontWeight=FontWeight.SemiBold)\n            fundamentals.forEachIndexed{i,name->Text("${i+1}. $name • Learning attribution",style=MaterialTheme.typography.bodySmall,color=MaterialTheme.colorScheme.onSurfaceVariant)}\n            HorizontalDivider()\n            Text("Top 5 standalone strategies",fontWeight=FontWeight.SemiBold)\n            if(strategies.isEmpty())Text("Learning • waiting for current ${direction.name} research setups",style=MaterialTheme.typography.bodySmall,color=MaterialTheme.colorScheme.onSurfaceVariant)\n            else strategies.forEachIndexed{i,x->\n                val perf=perfById[x.strategyId]\n                Text("${i+1}. ${x.strategyName} • score ${x.score.toInt()} • ${if(perf==null||perf.observations==0)"Learning" else "${"%.0f".format(perf.accuracyPct)}% / ${"%+.2f".format(perf.netExpectancyR)}R"}",style=MaterialTheme.typography.bodySmall)\n            }\n            HorizontalDivider()\n            Text("Top 5 combinations",fontWeight=FontWeight.SemiBold)\n            if(combos.isEmpty())Text("Learning • combination shadow evidence is still building",style=MaterialTheme.typography.bodySmall,color=MaterialTheme.colorScheme.onSurfaceVariant)\n            else combos.forEachIndexed{i,x->Text("${i+1}. ${x.componentStrategyIds.distinct().joinToString(" + ")} • score ${x.score.toInt()}",style=MaterialTheme.typography.bodySmall)}\n            Text("Catalogue ${summary?.catalogVersion?:"waiting"} • ${defs.size} active definitions • last refresh ${if(state.lastStrategyCatalogRefreshAt>0L)formatIstTimestamp(state.lastStrategyCatalogRefreshAt) else "not yet"}",style=MaterialTheme.typography.labelSmall,color=MaterialTheme.colorScheme.primary)\n        }\n    }\n}\n\n@Composable\n')
