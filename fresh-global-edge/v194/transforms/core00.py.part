from pathlib import Path
ROOT=Path("/tmp/v194")

def replace_once(path,old,new):
    p=ROOT/path
    text=p.read_text() if p.exists() else ""
    if old not in text:
        raise SystemExit(f"missing expected v1.8.3 block in {path}: {old[:80]!r}")
    p.write_text(text.replace(old,new,1))

def write_new(path,text):
    p=ROOT/path; p.parent.mkdir(parents=True,exist_ok=True); p.write_text(text)

write_new('CHANGELOG-v1.8.4.txt','Global Edge AI Trader v1.8.4\n\nArchitecture changes requested for the market-research workflow:\n- Removes Pressure from the production Forecast/Live architecture. Legacy Pressure records remain readable only for backward-compatible history.\n- Adds Diagonal Up / Diagonal Down research using intraday trend linearity (R²), hour-to-hour consistency, VWAP agreement and recent volume participation.\n- Shows up to 10 sustained upward and 10 sustained downward intraday trends from each completed market scan.\n- Diagonal is research/shadow only in v1.8.4; it does not publish executable calls until enough outcome evidence exists.\n- Restores an explicit 3 PM Next-Day Upper Circuit Forecast lane.\n- Moves the 3 PM UC publication window to 15:00–15:30 IST, with precomputation before 15:00 and near-close alarm wakeups at 15:00, 15:15 and 15:25.\n- Keeps the shared five-minute UC/Diagonal scan cadence, five-minute Strategy cadence and five-minute Global cadence.\n- Adds Settings Strategy Lab LONG/SHORT views with Top 5 candle-pattern research, Top 10 company fundamentals tracked, Top 5 standalone strategies and Top 5 strategy combinations.\n- Weekend nightly research now forces a strategy-catalog refresh and continues off-hours shadow/outcome reconciliation.\n- Preserves v1.8.3 information architecture and v1.8.2 publication/scheduler safeguards.\n')
