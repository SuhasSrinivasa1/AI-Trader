volumeRatio)}x",false)}\n                item{OutlinedButton(onClick=vm::runScan,enabled=!state.busy&&state.authenticated&&state.marketSession.isOpen,modifier=Modifier.fillMaxWidth()){Text("Refresh UC + Diagonal research")}}\n            }\n')
