@@ -656,6 +656,62 @@
         return filter.isBlank() || packageName.contains(filter, ignoreCase = true)
     }
 
+    /**
+     * Injects a user-entered paid-equity lifecycle event into exactly the same parser, NSE-master,
+     * authentication, risk, Shadow and optional Fast Track path used by captured notifications.
+     * Manual entry is not a live-trading bypass: when Fast Track/live execution is OFF it remains
+     * simulation/analysis only, and when enabled every existing broker/risk guard still applies.
+     */
+    suspend fun submitManualSignal(action: String, rawSymbol: String, observedPrice: Double? = null): Long {
+        val symbol = rawSymbol.trim().uppercase(Locale.US)
+        require(symbol.matches(Regex("[A-Z0-9&._-]{1,32}"))) { "Enter a valid NSE trading symbol" }
+        require(observedPrice == null || observedPrice > 0.0) { "Observed price must be greater than zero" }
+        val normalizedAction = action.trim().uppercase(Locale.US)
+        require(normalizedAction == "BUY" || normalizedAction == "BOOK_PROFIT") { "Choose BUY or BOOK PROFIT" }
+
+        val now = System.currentTimeMillis()
+        val body = when (normalizedAction) {
+            "BUY" -> buildString {
+                append("MANUAL EQUITY BUY: ").append(symbol)
+                observedPrice?.let { append("\nOBSERVED PRICE: ").append(fmt(it)) }
+            }
+            else -> buildString {
+                append("BOOK PROFIT: ").append(symbol)
+                observedPrice?.let { append("\nEXIT PRICE: ").append(fmt(it)) }
+                append("\nMANUAL ENTRY")
+            }
+        }
+        val title = if (normalizedAction == "BUY") "Manual paid Equity BUY" else "Manual Book Profit"
+        val parsed = parser.parse(title, body, body)
+        val expected = if (normalizedAction == "BUY") SignalType.TRADE_RELEASE else SignalType.BOOK_PROFIT
+        require(parsed.type == expected && parsed.symbol.equals(symbol, true)) { "Manual signal could not be validated" }
+        val fingerprintBytes = "manual\n$normalizedAction\n$symbol\n$now".toByteArray(Charsets.UTF_8)
+        val fingerprint = MessageDigest.getInstance("SHA-256").digest(fingerprintBytes).joinToString("") { "%02x".format(it) }
+        val id = dao.insert(
+            SignalEventEntity(
+                fingerprint = fingerprint,
+                receivedAtMs = now,
+                postedAtMs = now,
+                sourcePackage = MANUAL_SOURCE,
+                appLabel = "Manual entry",
+                title = title,
+                text = body,
+                bigText = body,
+                signalType = parsed.type.name,
+                symbol = symbol,
+                summary = parsed.summary(),
+                confidence = 1.0
+            )
+        )
+        require(id > 0L) { "Manual signal was already submitted" }
+        auditLogger.log("SIGNAL", "MANUAL_SUBMITTED", mapOf(
+            "event_id" to id, "signal_type" to parsed.type.name, "symbol" to symbol,
+            "observed_price" to observedPrice, "fast_track_effective" to preferences.settings.first().fastTrackEffective
+        ))
+        processEvent(id)
+        return id
+    }
+
     suspend fun isLiveExecutionEnabled(): Boolean = preferences.settings.first().liveExecutionEffective
 
     suspend fun processEvent(eventId: Long) {
