private const val ACTION_ENSURE_RUNNING = "com.multify.traderpro.action.ENGINE_START"
+        private const val ACTION_PROCESS_EVENT = "com.multify.traderpro.action.PROCESS_EVENT"
+        private const val ACTION_LISTENER_CONNECTED = "com.multify.traderpro.action.LISTENER_CONNECTED"
+        private const val ACTION_LISTENER_DISCONNECTED = "com.multify.traderpro.action.LISTENER_DISCONNECTED"
+        private const val EXTRA_EVENT_ID = "event_id"
+        private const val EXTRA_SIGNAL_TYPE = "signal_type"
+
+        fun ensureRunning(context: Context): Boolean = start(context, Intent(context, TradingEngineForegroundService::class.java).setAction(ACTION_ENSURE_RUNNING))
+
+        fun processEvent(context: Context, eventId: Long, signalType: String): Boolean = start(
+            context,
+            Intent(context, TradingEngineForegroundService::class.java)
+                .setAction(ACTION_PROCESS_EVENT)
+                .putExtra(EXTRA_EVENT_ID, eventId)
+                .putExtra(EXTRA_SIGNAL_TYPE, signalType)
+        )
+
+        fun listenerConnected(context: Context): Boolean = start(context, Intent(context, TradingEngineForegroundService::class.java).setAction(ACTION_LISTENER_CONNECTED))
+        fun listenerDisconnected(context: Context): Boolean = start(context, Intent(context, TradingEngineForegroundService::class.java).setAction(ACTION_LISTENER_DISCONNECTED))
+
+        private fun start(context: Context, intent: Intent): Boolean = runCatching {
+            ContextCompat.startForegroundService(context, intent)
+            true
+        }.getOrDefault(false)
+    }
+}
