+    @Test fun parsesManualBuyWithoutInventingTargetOrStop() {
+        val s = parser.parse("Manual paid Equity BUY", "MANUAL EQUITY BUY: TIMEX", "MANUAL EQUITY BUY: TIMEX\nOBSERVED PRICE: 739.10")
+        assertEquals(SignalType.TRADE_RELEASE, s.type)
+        assertEquals("TIMEX", s.symbol)
+        assertEquals(null, s.target)
+        assertEquals(null, s.stopLoss)
+    }
+
+    @Test fun parsesManualBookProfit() {
+        val s = parser.parse("Manual Book Profit", "BOOK PROFIT: TIMEX", "BOOK PROFIT: TIMEX\nEXIT PRICE: 739.10\nMANUAL ENTRY")
+        assertEquals(SignalType.BOOK_PROFIT, s.type)
+        assertEquals("TIMEX", s.symbol)
+        assertEquals(739.10, s.exitPrice!!, 0.0001)
+    }
