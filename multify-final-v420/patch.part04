+    fun submitManualSignal(action: String, symbol: String, observedPriceText: String) {
+        viewModelScope.launch {
+            remote.value = remote.value.copy(loading = true, error = null, message = null)
+            val price = observedPriceText.replace(",", "").replace("₹", "").trim().takeIf { it.isNotBlank() }?.toDoubleOrNull()
+            if (observedPriceText.isNotBlank() && price == null) {
+                remote.value = remote.value.copy(loading = false, error = "Observed price is optional, but must be a valid number when entered")
+                return@launch
+            }
+            runCatching { repository.submitManualSignal(action, symbol, price) }
+                .onSuccess { eventId ->
+                    remote.value = remote.value.copy(
+                        loading = false,
+                        message = "Manual ${if (action == "BUY") "BUY" else "Book Profit"} processed · event #$eventId",
+                        error = null
+                    )
+                    // High-resolution response sampling intentionally runs outside the submit path so
+                    // the UI returns immediately instead of waiting through the 5-minute sample window.
+                    launch { runCatching { repository.sampleSignal(eventId) } }
+                    refresh(silent = true)
+                }
+                .onFailure { remote.value = remote.value.copy(loading = false, error = it.userMessage()) }
+        }
+    }
+
     fun resetHalt() {
         viewModelScope.launch {
             remote.value = remote.value.copy(loading = true, error = null, message = null)
